# Jewellery Design Studio — environment variables
# Copy this file to .env and fill in your values. Do NOT commit .env.

# Required: OpenAI API key for gpt-image-2 image generation.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Google Gemini API key for nano-banana (low-cost iteration fallback).
# Leave blank if you do not need it.
GEMINI_API_KEY=

# Optional: Telegram one-tap approval buttons.
# Create a dedicated bot via @BotFather, then start a chat with it and read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# WARNING: use a dedicated bot token. getUpdates is single-consumer only.
# Reusing a token already polled by another service will cause approval
# callbacks to be missed and the studio poller to time out.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
