# Jewellery Design Studio - environment variables
# Copy to .env and fill in. .env is gitignored.

# Required: OpenAI API key for gpt-image-2 (the default image generator).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: Telegram bot for one-tap approval previews.
# Without these, renders are saved to disk only and you review them via file explorer.
# To create a bot: message @BotFather on Telegram, /newbot, follow prompts.
# To get your chat id: message your new bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates and read the "chat":{"id":...} value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Gemini key for nano-banana fallback (lower-cost first iteration).
# Useful if you want to iterate cheaply before committing to a gpt-image-2 render.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
